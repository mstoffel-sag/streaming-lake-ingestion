"&gt;cdc_*, latest_*&lt;br&gt;flattened, no struct columns&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Arial;strokeColor=#0070F2;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="645" y="170" width="160" height="90" as="geometry"/></mxCell><mxCell id="c15" value='&lt;b style="font-size:12px;color:#1D2D3E"&gt;curated_measurement&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#556B82"&gt;Task measurement_fact&lt;br&gt;All series, long format&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Arial;strokeColor=#0070F2;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="645" y="300" width="160" height="90" as="geometry"/></mxCell><mxCell id="c16" value='&lt;b style="font-size:12px;color:#1D2D3E"&gt;Delta Share&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#556B82"&gt;cumulocity_t2180777119&lt;br&gt;Recipient&lt;br&gt;sap-business-data-cloud&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Arial;strokeColor=#0070F2;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="835" y="170" width="150" height="220" as="geometry"/></mxCell><mxCell id="c17" value='&lt;b style="font-size:12px;color:#1D2D3E"&gt;bdc_check → bdc_publish&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#556B82"&gt;SHA-256 schema fingerprint&lt;br&gt;Republish on change:&lt;br&gt;share, ORD, CSN&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=middle;align=center;spacing=6;fontFamily=Arial;strokeColor=#0070F2;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="455" y="300" width="160" height="110" as="geometry"/></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;ro