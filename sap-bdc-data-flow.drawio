<mxfile host="drawio"><diagram id="bdc" name="BDC data flow"><mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value='&lt;b style="font-size:20px;color:#0070F2"&gt;Cumulocity data in SAP Business Data Cloud&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:12px;color:#556B82"&gt;Data flow of the two data products: SAP Databricks (Delta Share) and SAP Snowflake (Zerocopy Connector), consumed in SAP Datasphere and SAP Analytics Cloud&lt;/span&gt;' style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1300" height="50" as="geometry"/></mxCell><mxCell id="c3" value='&lt;b style="font-size:16px;color:#1D2D3E"&gt;Cumulocity&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Arial;strokeColor=#475E75;fillColor=#F5F6F7;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="320" height="820" as="geometry"/></mxCell><mxCell id="c4" value='&lt;b style="font-size:16px;color:#1D2D3E"&gt;SAP Business Data Cloud&lt;/b&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=24;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontFamily=Arial;strokeColor=#0070F2;fillColor=#EBF8FF;" vertex="1" parent="1"><mxGeometry x="400" y="70" width="1370" height="820" as="geometry"/></mxCell><mxCell id="c5" value='&lt;b style="font-size:12px;color:#1D2D3E"&gt;Cumulocity tenant&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px;color:#556B82"&gt;Inventory, measurements, events, alarms, operations&lt;/span&gt;' style="rounded=1;whiteSpace=wrap;html=1;arcSize=16;absoluteArcSize=1;strokeWidth=1.5;verticalAlign=middle;